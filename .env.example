# ==============================================================================
# EasyStock SaaS - Production & Staging Environment Configuration Template
# Copy this file to .env and provide real credentials
# ==============================================================================

# Neon Serverless PostgreSQL Connection Strings
# DATABASE_URL: Pooled connection string (via PgBouncer) for application queries
DATABASE_URL="postgresql://neondb_owner:[PASSWORD]@[HOST].us-east-2.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL: Direct unpooled connection string for Prisma schema migrations
DIRECT_URL="postgresql://neondb_owner:[PASSWORD]@[HOST].us-east-2.aws.neon.tech/neondb?sslmode=require"

# Cryptographic Session & Token Secret (generate with: openssl rand -base64 32)
SESSION_SECRET="replace-with-a-cryptographically-secure-random-32-byte-secret"

# Node Environment ("development" | "production" | "test")
NODE_ENV="production"

# Platform First-Admin Provisioning (used only by: npm run seed:admin)
ADMIN_BOOTSTRAP_EMAIL="admin@yourcompany.com"
ADMIN_BOOTSTRAP_PASSWORD="UseAStrongRandomPassword2026!"
ADMIN_BOOTSTRAP_NAME="System Administrator"

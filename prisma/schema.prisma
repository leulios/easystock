datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT_AGENT
  NONE
}

enum ShopRole {
  SHOP_OWNER
  SHOP_MANAGER
  SHOPKEEPER
}

enum MovementType {
  PURCHASE_RECEIPT
  SALE_DEDUCTION
  RETURN_RESTOCK
  MANUAL_ADJUSTMENT
  DAMAGE_WASTE
  TRANSFER_IN
  TRANSFER_OUT
}

enum SaleStatus {
  COMPLETED
  VOIDED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  MOBILE_MONEY
  STORE_CREDIT
  SPLIT
}

enum POStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// -----------------------------------------------------------------------------
// TENANCY & USERS
// -----------------------------------------------------------------------------

model Organization {
  id              String           @id @default(uuid())
  name            String
  slug            String           @unique
  plan            String           @default("standard") // standard, professional, enterprise
  planStatus      String           @default("active")   // active, past_due, cancelled
  maxShops        Int              @default(3)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  shops           Shop[]
  memberships     UserMembership[]
  categories      Category[]
  products        Product[]
  suppliers       Supplier[]
  customers       Customer[]
  auditLogs       AuditLog[]
  supportTickets  SupportTicket[]

  @@index([slug])
}

model Shop {
  id              String           @id @default(uuid())
  organizationId  String
  name            String
  code            String           // e.g. "MAIN-STORE", "WEST-BRANCH"
  address         String?
  phone           String?
  email           String?
  currency        String           @default("USD")
  taxRate         Decimal          @default(0.00) @db.Decimal(5, 2)
  taxNumber       String?
  receiptHeader   String?
  receiptFooter   String?
  allowNegativeStock Boolean       @default(false)
  isActive        Boolean          @default(true)
  suspensionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships     UserMembership[]
  inventoryItems  InventoryItem[]
  stockMovements  StockMovement[]
  sales           Sale[]
  purchaseOrders  PurchaseOrder[]
  expenses        Expense[]
  supportTickets  SupportTicket[]
  telegramAccounts TelegramAccount[]
  documents       BusinessDocument[]
  approvalRequests ApprovalRequest[]
  shopMessages    ShopMessage[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  fullName        String
  phone           String?
  platformRole    PlatformRole     @default(NONE)
  isActive        Boolean          @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  memberships     UserMembership[]
  sessions        UserSession[]
  auditLogs       AuditLog[]
  telegramAccounts TelegramAccount[]
  approvalRequests ApprovalRequest[]
  sentMessages     ShopMessage[]    @relation("SentShopMessages")
  receivedMessages ShopMessage[]    @relation("ReceivedShopMessages")

  @@index([email])
}

model UserMembership {
  id              String           @id @default(uuid())
  userId          String
  organizationId  String
  shopId          String?          // NULL implies organization-wide owner access
  role            ShopRole         @default(SHOPKEEPER)
  pinHash         String?          // Optional 4-6 digit quick POS switch PIN
  canViewReports  Boolean          @default(false)
  canApplyDiscount Boolean         @default(false)
  canAdjustStock  Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shop            Shop?            @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, shopId])
  @@index([organizationId, shopId])
}

model UserSession {
  id              String           @id @default(uuid())
  userId          String
  tokenHash       String           @unique
  activeShopId    String?
  ipAddress       String?
  userAgent       String?
  expiresAt       DateTime
  createdAt       DateTime         @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// CATALOG & INVENTORY
// -----------------------------------------------------------------------------

model Category {
  id              String           @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products        Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Product {
  id              String           @id @default(uuid())
  organizationId  String
  categoryId      String?
  name            String
  sku             String
  barcode         String?
  description     String?
  unitOfMeasure   String           @default("pcs")
  imageUrl        String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants        ProductVariant[]

  @@unique([organizationId, sku])
  @@index([organizationId, barcode])
}

model ProductVariant {
  id              String           @id @default(uuid())
  productId       String
  name            String           @default("Default")
  sku             String
  barcode         String?
  costPrice       Decimal          @default(0.00) @db.Decimal(12, 2)
  sellingPrice    Decimal          @default(0.00) @db.Decimal(12, 2)
  reorderLevel    Int              @default(5)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItems  InventoryItem[]
  stockMovements  StockMovement[]
  saleItems       SaleItem[]
  poItems         PurchaseOrderItem[]

  @@unique([productId, sku])
  @@index([barcode])
}

model InventoryItem {
  id              String           @id @default(uuid())
  shopId          String
  variantId       String
  quantity        Int              @default(0)
  version         Int              @default(0) // Optimistic locking
  updatedAt       DateTime         @updatedAt

  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variant         ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([shopId, variantId])
  @@index([shopId, quantity])
}

model StockMovement {
  id              String           @id @default(uuid())
  shopId          String
  variantId       String
  movementType    MovementType
  quantityDelta   Int              // Positive for in, negative for out
  resultingBalance Int
  unitCost        Decimal          @db.Decimal(12, 2)
  referenceType   String?          // "SALE", "PURCHASE_ORDER", "MANUAL", "TRANSFER"
  referenceId     String?          // Foreign ID to Sale or PO
  notes           String?
  performedBy     String?          // User ID
  createdAt       DateTime         @default(now())

  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variant         ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([shopId, variantId, createdAt])
  @@index([referenceType, referenceId])
}

// -----------------------------------------------------------------------------
// SALES & COMMERCE
// -----------------------------------------------------------------------------

model Customer {
  id              String           @id @default(uuid())
  organizationId  String
  name            String
  phone           String?
  email           String?
  address         String?
  outstandingCredit Decimal        @default(0.00) @db.Decimal(12, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales           Sale[]

  @@index([organizationId, phone])
}

model Sale {
  id              String           @id @default(uuid())
  shopId          String
  customerId      String?
  receiptNumber   String           // e.g. "RCP-20261018-0001"
  idempotencyKey  String           @unique
  status          SaleStatus       @default(COMPLETED)
  subtotal        Decimal          @db.Decimal(12, 2)
  taxAmount       Decimal          @db.Decimal(12, 2)
  discountAmount  Decimal          @default(0.00) @db.Decimal(12, 2)
  totalAmount     Decimal          @db.Decimal(12, 2)
  totalCost       Decimal          @db.Decimal(12, 2) // Instant COGS calculation
  cashierId       String           // User ID
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items           SaleItem[]
  payments        PaymentTransaction[]

  @@unique([shopId, receiptNumber])
  @@index([shopId, createdAt])
}

model SaleItem {
  id              String           @id @default(uuid())
  saleId          String
  variantId       String
  quantity        Int
  unitCost        Decimal          @db.Decimal(12, 2)
  unitPrice       Decimal          @db.Decimal(12, 2)
  discountAmount  Decimal          @default(0.00) @db.Decimal(12, 2)
  totalPrice      Decimal          @db.Decimal(12, 2)

  sale            Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant         ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([saleId])
}

model PaymentTransaction {
  id              String           @id @default(uuid())
  saleId          String
  paymentMethod   PaymentMethod
  amount          Decimal          @db.Decimal(12, 2)
  referenceCode   String?
  tenderedAmount  Decimal?         @db.Decimal(12, 2)
  changeGiven     Decimal?         @db.Decimal(12, 2)
  createdAt       DateTime         @default(now())

  sale            Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// -----------------------------------------------------------------------------
// PURCHASING & SUPPLIERS
// -----------------------------------------------------------------------------

model Supplier {
  id              String           @id @default(uuid())
  organizationId  String
  name            String
  contactName     String?
  phone           String?
  email           String?
  address         String?
  paymentTerms    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders  PurchaseOrder[]

  @@index([organizationId])
}

model PurchaseOrder {
  id              String           @id @default(uuid())
  shopId          String
  supplierId      String
  poNumber        String
  status          POStatus         @default(DRAFT)
  expectedDate    DateTime?
  totalAmount     Decimal          @default(0.00) @db.Decimal(12, 2)
  notes           String?
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier        Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items           PurchaseOrderItem[]

  @@unique([shopId, poNumber])
  @@index([shopId, status])
}

model PurchaseOrderItem {
  id              String           @id @default(uuid())
  purchaseOrderId String
  variantId       String
  orderedQuantity Int
  receivedQuantity Int             @default(0)
  unitCost        Decimal          @db.Decimal(12, 2)
  totalCost       Decimal          @db.Decimal(12, 2)

  purchaseOrder   PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant         ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
}

// -----------------------------------------------------------------------------
// EXPENSES & AUDITING
// -----------------------------------------------------------------------------

model Expense {
  id              String           @id @default(uuid())
  shopId          String
  category        String           // "Rent", "Utilities", "Salaries", "Supplies"
  amount          Decimal          @db.Decimal(12, 2)
  expenseDate     DateTime
  description     String?
  recordedById    String
  createdAt       DateTime         @default(now())

  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, expenseDate])
}

model AuditLog {
  id              String           @id @default(uuid())
  organizationId  String?
  shopId          String?
  userId          String?
  action          String           // "USER_LOGIN", "STOCK_ADJUSTMENT", "PRICE_OVERRIDE", etc.
  entityType      String           // "Product", "Sale", "User", "Shop"
  entityId        String?
  previousData    Json?
  newData         Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime         @default(now())

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([shopId, action])
}

// -----------------------------------------------------------------------------
// PLATFORM ADMINISTRATION & SUPPORT
// -----------------------------------------------------------------------------

model SupportTicket {
  id              String           @id @default(uuid())
  organizationId  String?
  shopId          String?
  reportedByEmail String
  title           String
  description     String
  severity        String           @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  status          String           @default("OPEN")   // "OPEN", "INVESTIGATING", "RESOLVED"
  assignedTo      String?
  resolutionNotes String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  shop            Shop?            @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([status, severity])
  @@index([organizationId, createdAt])
}

model PlatformSetting {
  key             String           @id
  value           String
  updatedAt       DateTime         @updatedAt
  updatedBy       String?
}

// -----------------------------------------------------------------------------
// TELEGRAM & COLLABORATION
// -----------------------------------------------------------------------------

model TelegramAccount {
  id                      String    @id @default(uuid())
  userId                  String
  shopId                  String
  telegramChatId          String    @unique
  telegramUsername        String?
  firstName               String?
  lastName                String?
  isActive                Boolean   @default(true)
  language                String    @default("en") // "en" or "am"
  notifications           String    @default("ALL") // "ALL", "ALERTS_ONLY", "NONE"
  notificationPreferences Json?     // { newSales, dailySummary, lowStock, inventoryRequests, approvals, purchaseInvoices, messages, businessEvents }
  linkToken               String?   @unique
  linkTokenExpires        DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop                    Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([shopId])
  @@index([telegramChatId])
}

model BusinessDocument {
  id               String    @id @default(uuid())
  shopId           String
  uploadedById     String?
  documentType     String    @default("PURCHASE_INVOICE") // "PURCHASE_INVOICE", "DELIVERY_NOTE", "EXPENSE_RECEIPT", "OTHER"
  status           String    @default("PENDING_REVIEW")   // "PENDING_REVIEW", "APPROVED", "REJECTED", "PROCESSED"
  title            String
  fileId           String    // Telegram file_id or storage key
  fileUrl          String?
  mimeType         String?
  fileSize         Int?
  notes            String?
  metadata         Json?     // extracted fields e.g. { invoiceNumber, supplierName, totalAmount }
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
  @@index([documentType])
}

model ApprovalRequest {
  id               String    @id @default(uuid())
  referenceCode    String    @default(cuid())
  shopId           String
  requesterId      String    // User ID (Shopkeeper or Staff)
  approvalType     String    // "STOCK_ADJUSTMENT", "RETURN_RESTOCK", "PURCHASE_RECEIVE", "EXPENSE"
  status           String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "CANCELLED", "COMPLETED"
  title            String
  details          Json      // payload e.g. { variantId, quantityDelta, reason, notes, unitCost }
  approverId       String?   // User ID (Owner)
  decisionNotes    String?
  decisionAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  requester        User      @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
  @@index([requesterId])
}

model ShopMessage {
  id              String       @id @default(uuid())
  referenceCode   String       @default(cuid())
  shopId          String
  senderId        String
  recipientId     String?      // NULL means broadcast announcement to all shopkeepers in the shop
  category        String       @default("GENERAL") // GENERAL, SALES_ISSUE, STOCK_REQUEST, CUSTOMER_ISSUE, PURCHASE_INFO, OTHER
  content         String
  fileId          String?      // Telegram file_id if photo or document attached
  fileType        String?      // "photo" | "document"
  isRead          Boolean      @default(false)
  status          String       @default("SENT") // SENT, DELIVERED, READ, RESOLVED
  replyToId       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  shop            Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sender          User         @relation("SentShopMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient       User?        @relation("ReceivedShopMessages", fields: [recipientId], references: [id], onDelete: SetNull)
  replyTo         ShopMessage? @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         ShopMessage[] @relation("MessageReplies")

  @@index([shopId, createdAt])
  @@index([senderId])
  @@index([recipientId])
}
